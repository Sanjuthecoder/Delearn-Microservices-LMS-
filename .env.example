# ==============================================
# DLMS Docker Environment Variables
# ==============================================
# IMPORTANT: This file is an EXAMPLE. Create a copy named .env
# and fill in your actual values. NEVER commit .env to GitHub!
# ==============================================

# Frontend Configuration
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# CORS Configuration (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# TiDB Database (for Auth and Enrollment services)
TIDB_URL=jdbc:mysql://your-tidb-host:4000/your-database?useSSL=true&requireSSL=true
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password

# MongoDB (for Course and Media services)
COURSE_MONGODB_URI=mongodb+srv://username:password@cluster/course_db
MEDIA_MONGODB_URI=mongodb+srv://username:password@cluster/media_db

# Pinata IPFS (for Media service)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key

# Hugging Face (for ChatBot service)
HF_TOKEN=your_huggingface_token
